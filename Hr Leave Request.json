    {
      "parameters": {
        "jsCode": "const req = $('Calculate days').first().json;\nconst cap = 2;\nconst rows = $input.all().map(i => i.json);\nconst clashDates = [];\nfor (let d = new Date(req.leave_start + 'T00:00:00Z');\n     d <= new Date(req.leave_end + 'T00:00:00Z');\n     d.setUTCDate(d.getUTCDate() + 1)) {\n  const day = d.toISOString().slice(0, 10);\n  const count = rows.filter(r => r.start_date <= day && r.end_date >= day).length;\n  if (count >= cap) clashDates.push(day);\n}\nreturn [{ json: { ...req, conflict: clashDates.length > 0, clashDates: clashDates.join(', ') } }];"
      },
